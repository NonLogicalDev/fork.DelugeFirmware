    {
      "id": "slice[index]",
      "label": "Manual slice pad",
      "kind": "pad-role",
      "match": "^slice\\[(index|[0-9]+)\\]$",
      "events": [
        "down",
        "up"
      ],
      "holdable": true,
      "resolver": "Manual Slicer: padMatrix x=(index % 4)+floor(index/16)*4, y=floor(index/4)%4. index must be a valid slice for actions requiring an existing slice; delete additionally requires index==currentSlice.",
      "sources": [
        {
          "file": "src/deluge/gui/ui/slicer.cpp",
          "symbol": "Slicer::buttonAction",
          "anchor": "(currentSlice % 4) + (currentSlice / 16) * 4"
