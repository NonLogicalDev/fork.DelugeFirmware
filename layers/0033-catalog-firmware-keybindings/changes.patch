+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Deluge keybinding record, draft 2",
+  "type": "object",
+  "required": [
+    "id",
+    "context",
+    "key",
+    "command",
+    "args",
+    "title",
+    "description",
+    "when",
+    "tags",
+    "keywords",
+    "sources",
+    "verification"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "id": {
+      "type": "string",
+      "minLength": 1
+    },
+    "context": {
+      "type": "object",
+      "minProperties": 1,
+      "additionalProperties": false,
+      "properties": {
+        "view": {
+          "type": "string",
+          "minLength": 1
+        },
+        "layout": {
+          "type": "string",
+          "minLength": 1
+        },
+        "output": {
+          "type": "string",
+          "minLength": 1
+        },
+        "dispatch": {
+          "type": "string",
+          "minLength": 1
+        }
+      }
+    },
+    "key": {
+      "oneOf": [
+        {
+          "$ref": "#/$defs/event"
+        },
+        {
+          "$ref": "#/$defs/gesture"
+        },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "sequence"
+          ],
+          "properties": {
+            "sequence": {
+              "type": "array",
+              "minItems": 2,
+              "items": {
+                "oneOf": [
+                  {
+                    "$ref": "#/$defs/event"
+                  },
+                  {
+                    "$ref": "#/$defs/gesture"
+                  }
+                ]
+              }
+            },
+            "maxGapMs": {
+              "type": "number",
+              "exclusiveMinimum": 0
+            },
+            "inclusive": {
+              "type": "boolean"
+            },
+            "cancelOn": {
+              "type": "array",
+              "minItems": 1,
+              "items": {
+                "type": "object",
+                "required": [
+                  "trigger"
+                ],
+                "additionalProperties": false,
+                "properties": {
+                  "trigger": {
+                    "enum": [
+                      "button.down",
+                      "pad.down"
+                    ]
+                  },
+                  "except": {
+                    "type": "array",
+                    "items": {
+                      "$ref": "#/$defs/control"
+                    },
+                    "uniqueItems": true
+                  }
+                }
+              }
+            }
+          },
+          "dependentRequired": {
+            "maxGapMs": [
+              "inclusive"
+            ],
+            "inclusive": [
+              "maxGapMs"
+            ]
+          }
+        }
+      ]
+    },
+    "command": {
+      "type": "string",
+      "minLength": 1
+    },
+    "args": {
+      "type": "object"
+    },
+    "title": {
+      "type": "string",
+      "minLength": 1
+    },
+    "description": {
+      "type": "string",
+      "minLength": 1
+    },
+    "when": {
+      "type": "string",
+      "minLength": 1
+    },
+    "tags": {
+      "type": "array",
+      "items": {
+        "enum": [
+          "transport",
+          "recording",
+          "looping",
+          "clipboard",
+          "navigation",
+          "editing",
+          "sampling",
+          "slicing",
+          "automation",
+          "midi",
+          "sound-design",
+          "system"
+        ]
+      },
+      "uniqueItems": true
+    },
+    "keywords": {
+      "type": "array",
+      "items": {
+        "type": "string",
+        "minLength": 1
+      },
+      "uniqueItems": true
+    },
+    "requires": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "condition",
+          "failure"
+        ],
+        "properties": {
+          "condition": {
+            "type": "string",
+            "minLength": 1
+          },
+          "failure": {
+            "type": "string",
+            "minLength": 1
+          }
+        }
+      }
+    },
+    "dispatch": {
+      "type": "object"
+    },
+    "lifecycle": {
+      "type": "object"
+    },
+    "feedback": {
+      "type": "object"
+    },
+    "sources": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "file",
+          "symbol",
+          "role"
+        ],
+        "properties": {
+          "file": {
+            "type": "string",
+            "minLength": 1
+          },
+          "symbol": {
+            "type": "string",
+            "minLength": 1
+          },
+          "role": {
+            "type": "string",
+            "minLength": 1
+          },
+          "anchor": {
+            "type": "string",
+            "minLength": 1
+          }
+        }
+      }
+    },
+    "availability": {
+      "type": "object"
+    },
+    "verification": {
+      "type": "object",
+      "required": [
+        "source",
+        "device",
+        "reviewedOn",
+        "scope"
+      ],
+      "properties": {
+        "source": {
+          "enum": [
+            "reviewed",
+            "partial",
+            "unreviewed"
+          ]
+        },
+        "device": {
+          "type": "string",
+          "minLength": 1
+        },
+        "reviewedOn": {
+          "type": "string",
+          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
+        },
+        "scope": {
+          "type": "string",
+          "minLength": 1
+        },
+        "findings": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "uniqueItems": true
+        }
+      },
+      "additionalProperties": false
+    }
+  },
+  "$defs": {
+    "control": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]*(\\[[a-zA-Z0-9_$,]+\\])?$"
+    },
+    "gesture": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "hold": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "$ref": "#/$defs/control"
+          }
+        },
+        "trigger": {
+          "$ref": "#/$defs/event"
+        }
+      },
+      "required": [
+        "trigger"
+      ]
+    },
+    "event": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9.-]*(\\[[a-zA-Z0-9_$,]+\\])?\\.(down|up|turn)$"
+    }
+  }
+}
