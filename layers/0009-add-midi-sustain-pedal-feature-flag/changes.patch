diff --git a/src/deluge/model/instrument/midi_sustain_deferred_notes.h b/src/deluge/model/instrument/midi_sustain_deferred_notes.h
new file mode 100644
index 0000000000000000000000000000000000000000..33355b8f1121ddc1aea89e4a9a8737b1c6479e5c
--- /dev/null
+++ b/src/deluge/model/instrument/midi_sustain_deferred_notes.h
@@ -0,0 +1,87 @@
+/*
+ * Copyright © 2026 Synthstrom Audible Limited
+ *
