+
+#pragma once
+
+#include "definitions_cxx.hpp"
+#include <cstdint>
+
+namespace deluge::gui::slicer_playhead {
+
+enum class Source : uint8_t {
+	BROWSER_PREVIEW,
+	SELECTED_SOUND,
+};
+
+constexpr Source getSource(bool isRegionMode, bool usesExistingKit) {
+	return isRegionMode && !usesExistingKit ? Source::BROWSER_PREVIEW : Source::SELECTED_SOUND;
+}
+
+constexpr bool isWaveformRow(bool isRegionMode, int32_t row) {
+	return isRegionMode || row >= kDisplayHeight / 2;
+}
+
+} // namespace deluge::gui::slicer_playhead
