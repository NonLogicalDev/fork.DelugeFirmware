+	nameIsDiscardable = other.nameIsDiscardable;
+	midiInput = other.midiInput;
+	muteMIDICommand = other.muteMIDICommand;
+	arpSettings.cloneFrom(&other.arpSettings);
+
+	return Error::NONE;
+}
