diff --git a/tests/spec/oled_clip_progress_ruler_spec.cpp b/tests/spec/oled_clip_progress_ruler_spec.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..649a41bb9f58688f87dfc714fd499ea092a97820
--- /dev/null
