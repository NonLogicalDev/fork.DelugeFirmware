+
+uint32_t hexToInt(char const* string) {
+	return static_cast<uint32_t>(strtoul(string, nullptr, 16));
+}
+
+bool getNibble(char ch, int* nibble) {
+	if (ch >= '0' && ch <= '9') {
+		*nibble = ch - '0';
+		return true;
+	}
+	if (ch >= 'A' && ch <= 'F') {
+		*nibble = ch - 'A' + 10;
+		return true;
+	}
+	if (ch >= 'a' && ch <= 'f') {
+		*nibble = ch - 'a' + 10;
+		return true;
+	}
+	return false;
+}
